rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when `sender` has a pending request in `owner`'s space.
    function pendingReq(owner, sender) {
      return exists(/databases/$(database)/documents/users/$(owner)/friendRequests/$(sender));
    }

    // UGC-1a: true when EITHER user has the other on their private blocklist
    // (users/{uid}/account/blocklist → { blockedUids: [String] }). exists()
    // short-circuits before get(); data.get(...,[]) defaults a malformed/missing
    // field so a bad doc denies only interactions toward ITS OWN owner, never
    // errors the rule set. Interaction bans (duel create, friend request) are
    // SYMMETRIC — denied if a blocks b OR b blocks a.
    function blockedEither(a, b) {
      return (exists(/databases/$(database)/documents/users/$(a)/account/blocklist)
                && b in get(/databases/$(database)/documents/users/$(a)/account/blocklist).data.get('blockedUids', []))
          || (exists(/databases/$(database)/documents/users/$(b)/account/blocklist)
                && a in get(/databases/$(database)/documents/users/$(b)/account/blocklist).data.get('blockedUids', []));
    }

    // GUILD-CAP-1: the guild doc's `memberCount` may change by EXACTLY ±1, and only
    // inside a batch that also performs the matching membership write. Two named
    // helpers (beside blockedEither, the established helper precedent) for the
    // count-only guild-update branch; reviewable in isolation.
    //
    // get()/getAfter() on the guild doc read its pre-/post-batch memberCount (the
    // doc is updated in THIS batch). exists()/existsAfter() on the actor's OWN
    // member doc prove the paired self-join (create) or self-leave (delete) is in
    // the SAME batch. get()/getAfter()/exists() on one doc = one access (the
    // established reviewer ruling), so these are cheap.
    function canIncrementMemberCount(guildId) {
      return getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
               == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount + 1
          && getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount <= 40  // KEEP IN SYNC WITH DataManager.maxMembers
          && (
               // owner approves a requester (+1 for someone else's new member doc)
               request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid
               ||
               // self-join: the caller creates their OWN member doc in this same batch
               (!exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid))
                  && existsAfter(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid)))
             );
    }

    // KNOWN LIMITATION: rules cannot pair an arbitrary owner member-delete with this
    // decrement (the batch's member target is invisible from this doc's context). An
    // owner can therefore corrupt their OWN guild's counter downward. Self-inflicted,
    // bounded to their guild, healed by re-running the backfill. Accepted (GUILD-CAP-1).
    function canDecrementMemberCount(guildId) {
      return getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
               == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount - 1
          && getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount >= 0
          && (
               // owner kicks a member (-1)
               request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid
               ||
               // self-leave: the caller deletes their OWN member doc in this same batch
               (exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid))
                  && !existsAfter(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid)))
             );
    }

    // Root user document. Owner-only read/write/delete on users/{userId} ITSELF
    // (the account-info root doc + the account-deletion path need it; the recursive
    // wildcard matched it before). This match is NON-recursive: it covers only the
    // root document, never its subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Owner-only private subcollections — EXPLICIT allowlist (replaces the old
    // recursive `{document=**}` catch-all that was Critical finding C1).
    //
    // IMPORTANT: Firestore combines every matching `allow` with OR semantics — there
    // is no most-specific-wins and no deny. NEVER reintroduce a recursive owner
    // wildcard ({document=**}) under /users: it would silently bypass the friend/
    // public/feed/sharedItems rules below (exactly the C1 hole). This match
    // intentionally covers EXACTLY ONE collection level; nested paths (e.g.
    // feedEvents/*/cheers) are governed solely by their dedicated blocks, and the
    // allowlist must NEVER contain a collection that has its own rules block
    // (friendRequests, sentRequests, friends, public, feedEvents, sharedItems).
    // The list is reconciled against the code (FirestoreServiceImpl collection
    // helpers + deleteAllUserData's knownSubcollections) — keep all three in sync.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collection in [
             'foodEntries', 'dailyGoals', 'dailyQuests', 'moodEntries',
             'customFoods', 'savedMeals', 'savedRecipes', 'personalBaselines',
             'foodFingerprints', 'userProgress', 'profile', 'account', 'badges',
             'qteDays'
           ];
    }

    // Username uniqueness index (Friend System Phase 1)
    match /usernames/{handleKey} {
      allow read: if request.auth != null;

      // Create only an unclaimed handle, pointing to your own uid,
      // exact field set, same format + reserved rules as the client.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == handleKey
        && handleKey.matches('^[a-z][a-z0-9_]{2,19}$')
        && !(handleKey in [
             'admin', 'root', 'support', 'system', 'healthbar',
             'healthbarapp', 'guest', 'null', 'undefined', 'me', 'you',
             'official', 'staff', 'team', 'founder', 'developer',
             'mod', 'moderator'
           ]);

      // No in-place renames. Changes use delete + create (transaction).
      allow update: if false;

      // Only the owner may release their handle.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Username → login-email mapping for username sign-in.
    // Single-doc get is public: the login screen resolves a username to its
    // email BEFORE the user is authenticated. List is denied so emails
    // cannot be bulk-harvested.
    match /loginHandles/{handleKey} {
      allow get: if true;
      allow list: if false;

      // Only the signed-in owner of the matching username may write,
      // and only with their own uid and the email on their auth token.
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/usernames/$(handleKey)).data.uid
             == request.auth.uid;

      // Only the owner may release their mapping.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Friend System Phase 2 — incoming friend requests (written cross-user).
    match /users/{ownerUid}/friendRequests/{fromUid} {
      allow read: if request.auth != null && request.auth.uid == ownerUid;

      // Sender creates in the recipient's space: doc id == sender uid,
      // stamped fromUid == sender, no self-request, exact field set.
      allow create: if request.auth != null
        && request.auth.uid == fromUid
        && fromUid != ownerUid
        && request.resource.data.fromUid == fromUid
        && request.resource.data.keys().hasOnly(
             ['fromUid', 'fromUsername', 'fromDisplayName', 'createdAt',
              'fromAvatarIcon', 'fromAvatarColor'])
        && request.resource.data.fromUsername is string
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromUsername.size() < 300
        && request.resource.data.fromDisplayName.size() < 300
        // D3b avatar fields — bounds per the D3a note at public/stats.
        && (!('fromAvatarIcon' in request.resource.data)
            || (request.resource.data.fromAvatarIcon is string && request.resource.data.fromAvatarIcon.size() < 40))
        && (!('fromAvatarColor' in request.resource.data)
            || (request.resource.data.fromAvatarColor is string && request.resource.data.fromAvatarColor.size() < 40))
        // UGC-1a: no friend request if either party blocks the other.
        && !blockedEither(ownerUid, fromUid);

      allow update: if false;

      // Recipient (accept/decline) or sender (cancel) may delete.
      allow delete: if request.auth != null
        && (request.auth.uid == ownerUid || request.auth.uid == fromUid);
    }

    // Sender's own mirror of an outgoing request.
    match /users/{ownerUid}/sentRequests/{toUid} {
      allow read: if request.auth != null && request.auth.uid == ownerUid;

      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && toUid != ownerUid
        && request.resource.data.toUid == toUid
        && request.resource.data.keys().hasOnly(
             ['toUid', 'toUsername', 'createdAt'])
        && request.resource.data.toUsername is string
        && request.resource.data.toUsername.size() < 300;

      allow update: if false;

      // Owner (cancel) or recipient (accept/decline clears mirror) may delete.
      allow delete: if request.auth != null
        && (request.auth.uid == ownerUid || request.auth.uid == toUid);
    }

    // Friend edges. Creation requires a matching pending request, so
    // neither party can unilaterally insert themselves into a list.
    match /users/{ownerUid}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == ownerUid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['friendUid', 'friendUsername', 'friendDisplayName', 'since',
              'friendAvatarIcon', 'friendAvatarColor'])
        && request.resource.data.friendUid == friendUid
        && request.resource.data.friendUsername is string
        && request.resource.data.friendDisplayName is string
        && request.resource.data.friendUsername.size() < 300
        && request.resource.data.friendDisplayName.size() < 300
        // D3b avatar fields (snapshot per edge).
        && (!('friendAvatarIcon' in request.resource.data)
            || (request.resource.data.friendAvatarIcon is string && request.resource.data.friendAvatarIcon.size() < 40))
        && (!('friendAvatarColor' in request.resource.data)
            || (request.resource.data.friendAvatarColor is string && request.resource.data.friendAvatarColor.size() < 40))
        && (
             (request.auth.uid == ownerUid
               && pendingReq(ownerUid, friendUid))
             || (request.auth.uid == friendUid
               && pendingReq(friendUid, ownerUid))
           );

      allow update: if false;

      // Either party may delete (unfriend is mutual). Account deletion
      // also uses this: the doc id equals the deleter's uid. Intentional.
      allow delete: if request.auth != null
        && (request.auth.uid == ownerUid || request.auth.uid == friendUid);
    }

    // Friend Leaderboard (Friend System Phase 3) — owner-published stats
    // projection. Reads are open to any signed-in user (NAV-1a / ruling B1):
    // the projection contains zero private data by construction, so there is no
    // read-side boundary to enforce. The write block below remains the
    // enforcement of what can be published.
    match /users/{ownerUid}/public/stats {
      allow read: if request.auth != null;

      // Only the owner publishes their own stats, with the exact field set
      // and value ranges.
      // NOTE (F1 / finding C1): this ENTIRE owner-side validation — keys().hasOnly,
      // the type/range checks, and the rr ceiling below — is only ENFORCEABLE now that
      // the recursive {document=**} owner catch-all is gone. That match used to
      // OR-grant the owner an unconditional write to public/stats, silently nullifying
      // every check in this block (a modified client could publish arbitrary rr/level
      // or extra fields). Do not be surprised these checks "suddenly" bite.
      // updatedAt is intentionally not type-checked: the
      // serverTimestamp sentinel can trip a type rule at evaluation time
      // (same reasoning as usernames.claimedAt). joinedAt is likewise not
      // type-checked — it is copied from account/info.createdAt, which may
      // itself hold a server-timestamp value.
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(
             ['username', 'displayName', 'level', 'totalXP', 'currentStreak',
              'rank', 'rr', 'weeklyGoalsMet', 'weeklyAdherence', 'updatedAt',
              'longestStreak', 'joinedAt', 'badgeCount', 'earnedBadgeIds',
              'avatarIcon', 'avatarColor'])
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.rank is string
        && request.resource.data.username.size() < 300
        && request.resource.data.displayName.size() < 300
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.totalXP is int
        && request.resource.data.totalXP >= 0
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 0
        && request.resource.data.weeklyGoalsMet is int
        && request.resource.data.weeklyGoalsMet >= 0
        && request.resource.data.weeklyGoalsMet <= 7
        && request.resource.data.weeklyAdherence is number
        && request.resource.data.weeklyAdherence >= 0
        && request.resource.data.weeklyAdherence <= 1
        && request.resource.data.longestStreak is int
        && request.resource.data.longestStreak >= 0
        && request.resource.data.badgeCount is int
        && request.resource.data.badgeCount >= 0
        && request.resource.data.earnedBadgeIds is list
        && request.resource.data.earnedBadgeIds.size() <= 50
        // D5: rr ceiling mirrors the duelQueue ticket bound (rr <= 100000).
        && (!('rr' in request.resource.data)
            || (request.resource.data.rr is int && request.resource.data.rr >= 0
                && request.resource.data.rr <= 100000))
        // D3a preset avatar. size() < 40 is a SANITY bound, not a catalog contract — the
        // catalog grows without rules changes; unknown ids fall back client-side.
        && (!('avatarIcon' in request.resource.data)
            || (request.resource.data.avatarIcon is string && request.resource.data.avatarIcon.size() < 40))
        && (!('avatarColor' in request.resource.data)
            || (request.resource.data.avatarColor is string && request.resource.data.avatarColor.size() < 40));

      // Owner-only delete: no field validation is possible on delete, and
      // account deletion must be able to remove this doc.
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Friend Activity Feed (Friend System Phase 7) — owner-published milestone
    // events. The friend-edge existence check is the cross-user read boundary:
    // a non-friend (or former friend) gets permission-denied, which the client
    // treats as "no events." Events are immutable; the deterministic doc id
    // makes emission idempotent (re-emit = same id, no duplicate).
    match /users/{ownerUid}/feedEvents/{eventId} {
      // Owner, or any user in the owner's friends list, may read (list + get).
      allow read: if request.auth != null
        && (
             request.auth.uid == ownerUid
             || exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.auth.uid))
           );

      // Owner-only create, exact shape, known types. createdAt is intentionally
      // not type-checked (server-timestamp sentinel, same as public/stats.updatedAt).
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(['type', 'value', 'username', 'displayName', 'createdAt'])
        && request.resource.data.type in ['badge', 'level', 'rank', 'streak']
        && request.resource.data.value is string
        && request.resource.data.value.size() < 100
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.username.size() < 300
        && request.resource.data.displayName.size() < 300;

      // Events are immutable; owner may delete (pruning + account deletion).
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Cheers (Friend System Phase 8) — one 💪 per friend per event. Doc id =
    // cheerer's uid ⇒ idempotent by construction. Cross-user write into the
    // owner's space with zero cross-user private reads (cheerer stamps their
    // own identity snapshot), same posture as friend requests.
    match /users/{ownerUid}/feedEvents/{eventId}/cheers/{cheererUid} {
      // Owner and the owner's friends may read (counts + names render for both).
      allow read: if request.auth != null
        && (
             request.auth.uid == ownerUid
             || exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.auth.uid))
           );

      // Only a friend of the owner may cheer, only as themselves (doc id ==
      // auth uid), never the owner, exact field shape. Re-cheer is blocked by
      // update:false below. createdAt is not type-checked (server-timestamp
      // sentinel, consistent with prior prompts).
      allow create: if request.auth != null
        && request.auth.uid == cheererUid
        && cheererUid != ownerUid
        && exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(cheererUid))
        && request.resource.data.cheererUid == cheererUid
        && request.resource.data.keys().hasOnly(['cheererUid', 'username', 'displayName', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.username.size() < 300
        && request.resource.data.displayName.size() < 300;

      allow update: if false;

      // Cheerer may retract; owner may clean up (pruning, account deletion).
      allow delete: if request.auth != null
        && (request.auth.uid == cheererUid || request.auth.uid == ownerUid);
    }

    // Meal/Recipe Sharing (Friend System Phase 9) — a friend delivers a snapshot
    // into the recipient's private inbox. Cross-user write of stamped data, zero
    // cross-user private reads (the share carries the full payload). No unsend:
    // delivered shares belong to the recipient.
    match /users/{recipientUid}/sharedItems/{shareId} {
      // Inbox is private to the recipient.
      allow read: if request.auth != null && request.auth.uid == recipientUid;

      // Only a friend of the recipient may deliver, only as themselves, never to
      // self, exact shape, bounded sizes, known kinds. The friend-edge check uses
      // request.resource.data.fromUid (== auth uid by the first condition) since
      // the sender uid is not in the path here. createdAt is not type-checked
      // (server-timestamp sentinel, consistent throughout).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != recipientUid
        && exists(/databases/$(database)/documents/users/$(recipientUid)/friends/$(request.resource.data.fromUid))
        && request.resource.data.keys().hasOnly(
             ['fromUid', 'fromUsername', 'fromDisplayName', 'kind', 'name',
              'contentJSON', 'yield', 'purityScore', 'createdAt'])
        && request.resource.data.kind in ['meal', 'recipe']
        && request.resource.data.fromUsername is string
        && request.resource.data.fromDisplayName is string
        && request.resource.data.name is string
        && request.resource.data.fromUsername.size() < 300
        && request.resource.data.fromDisplayName.size() < 300
        && request.resource.data.name.size() < 300
        && request.resource.data.contentJSON is string
        && request.resource.data.contentJSON.size() < 200000
        && request.resource.data.yield is int
        && request.resource.data.yield >= 0
        && request.resource.data.purityScore is int
        && request.resource.data.purityScore >= 0
        && request.resource.data.purityScore <= 100;

      allow update: if false;

      // Recipient-only delete (save / dismiss / cleanup). No sender unsend.
      allow delete: if request.auth != null && request.auth.uid == recipientUid;
    }

    // ===================================================================
    // Guilds (Prompt G1) — the first shared entity not owned by one user.
    // Two top-level collections: guilds/{guildCode} (the shared entity) and
    // guildMemberships/{uid} (the one-guild lock, doc-id-as-lock pattern).
    // ===================================================================

    // Top-level guilds
    match /guilds/{guildId} {
      // R7d — read is SPLIT so 'private' is hidden at the enforcement boundary, not
      // merely filtered by the client.
      //
      // Get by code: anyone authenticated (codes are random and unguessable — intentional).
      allow get: if request.auth != null;
      // List: only non-private guilds. Forces directory queries to constrain on joinPolicy;
      // an unconstrained list is denied, so 'private' is hidden at the rules boundary.
      allow list: if request.auth != null
                  && resource.data.joinPolicy != 'private';

      // Create: founder creates a guild they own, valid shape, with a 'create'
      // (the rules reject a create over an existing code, giving the client its
      // collision signal). GUILD-CAP-1 born the count at exactly 1; GUILD-RULES-1a
      // relaxes that to bi-generational conditional-presence for the transition —
      // a new client still writes memberCount == 1, a pre-counter client omits it.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.joinPolicy in ['open','request','private']
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 30
                    && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 140))
                    // legacy path := an identical document transition except memberCount
                    // is unchanged (the write provably does not touch the counter); for a
                    // CREATE that is a memberCount-ABSENT write from a pre-counter client.
                    // TODO-strict-rules-at-2.1: restore mandatory presence —
                    //   && 'memberCount' in request.resource.data
                    //   && request.resource.data.memberCount == 1
                    && (!('memberCount' in request.resource.data)
                        || (request.resource.data.memberCount is int
                            && request.resource.data.memberCount == 1))
                    && request.resource.data.keys().hasOnly(['name','ownerUid','joinPolicy','description','createdAt','memberCount']);

      // Update — GUILD-CAP-1 split the single owner-settings rule into two branches:
      //   A) owner edits settings (name/policy/description); the count is provably
      //      UNTOUCHED (memberCount not among the diff's affected keys).
      //   B) a membership batch changes ONLY memberCount, by a validated ±1
      //      (join/approve/leave/kick) — see canIncrement/canDecrementMemberCount.
      //      The actor need NOT be the owner here (a self-joiner/self-leaver updates
      //      the count for their own batch); the helpers gate WHO may do WHICH delta.
      allow update: if request.auth != null
                    && (
                         // A) owner settings update.
                         (
                           request.auth.uid == resource.data.ownerUid
                           && request.resource.data.ownerUid == resource.data.ownerUid
                           && request.resource.data.createdAt == resource.data.createdAt
                           && request.resource.data.joinPolicy in ['open','request','private']
                           && request.resource.data.name is string
                           && request.resource.data.name.size() >= 1
                           && request.resource.data.name.size() <= 30
                           && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 140))
                           && !('memberCount' in request.resource.data.diff(resource.data).affectedKeys())
                         )
                         ||
                         // B) count-only maintenance: exactly memberCount changes, by a
                         //    validated ±1 (the <= 40 ceiling lives in the helper).
                         (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
                           && (canIncrementMemberCount(guildId) || canDecrementMemberCount(guildId))
                         )
                       );

      // Delete (disband): owner only.
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      match /members/{memberUid} {
        // GUILD-UI-1: roster is identity snapshots only (username/displayName/role/joinedAt/avatar) — same privacy class as the B1 public/stats opening. joinRequests stay gated.
        allow read: if request.auth != null;

        // Create — three legitimate paths, all stamping uid == doc id, exact shape:
        allow create: if request.auth != null
                      && request.resource.data.uid == memberUid
                      && request.resource.data.keys().hasOnly(['uid','username','displayName','role','joinedAt',
                           'avatarIcon','avatarColor'])
                      && request.resource.data.username is string && request.resource.data.username.size() < 300
                      && request.resource.data.displayName is string && request.resource.data.displayName.size() < 300
                      // D3b avatar fields (member snapshot).
                      && (!('avatarIcon' in request.resource.data)
                          || (request.resource.data.avatarIcon is string && request.resource.data.avatarIcon.size() < 40))
                      && (!('avatarColor' in request.resource.data)
                          || (request.resource.data.avatarColor is string && request.resource.data.avatarColor.size() < 40))
                      && (
                           // a) founder adds self as owner (they own the guild).
                           //    getAfter (NOT get): createGuild batches guild+member+lock in ONE
                           //    commit, so the guild doc doesn't exist pre-batch — get() would read
                           //    null and deny the whole batch. getAfter sees the same-batch guild;
                           //    for an EXISTING guild it falls back to current state, so ownerUid
                           //    must still equal the caller (can't claim someone else's guild).
                           //    GUILD-CAP-1: the SAME getAfter pins the founder-set count to 1
                           //    (createGuild writes memberCount:1 literally in this same batch).
                           (request.auth.uid == memberUid
                              && request.resource.data.role == 'owner'
                              && getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid == request.auth.uid
                              // TODO-strict-rules-at-2.1: restore strict founder count —
                              //   && getAfter(guild).data.memberCount == 1
                              // Transitional (strict founder-count OR legacy): a pre-counter client's
                              // createGuild omits memberCount, so the guild it creates in this same
                              // batch has no counter. Existence-first ordering matches the file's
                              // conditional-presence idiom (avatar/rr) — the absent case short-circuits
                              // before the field access.
                              && (!('memberCount' in getAfter(/databases/$(database)/documents/guilds/$(guildId)).data)
                                  || getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount == 1))
                           ||
                           // b) self-join an OPEN or PRIVATE guild as member (and not already in any
                           //    guild). R7d: 'private' is hidden from the directory, NOT harder to
                           //    join — holding the code is the whole gate, exactly as for 'open'.
                           //    (The joinRequests create below stays pinned to 'request', so a
                           //    request to a private guild remains impossible.)
                           (request.auth.uid == memberUid
                              && request.resource.data.role == 'member'
                              && get(/databases/$(database)/documents/guilds/$(guildId)).data.joinPolicy in ['open','private']
                              && !exists(/databases/$(database)/documents/guildMemberships/$(memberUid))
                              // TODO-strict-rules-at-2.1: restore strict +1 —
                              //   && getAfter(guild).data.memberCount == get(guild).data.memberCount + 1
                              // Transitional, absence-escape FIRST (existence-first idiom, arm-a template):
                              // a counterless guild — arm D1 lets pre-counter clients keep creating one —
                              // would ERROR on getAfter/get memberCount, so !('memberCount' in get(guild))
                              // short-circuits and admits the old-client join (no tick). Else a new client
                              // ticks the paired +1 (count-only update branch still caps <= 40), or an old
                              // client joins a counted guild without ticking (getAfter == get). A NEW client
                              // on a counterless guild stays denied by the count-only update branch until a
                              // backfill re-run.
                              && (!('memberCount' in get(/databases/$(database)/documents/guilds/$(guildId)).data)
                                   || (getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
                                         == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount + 1
                                       && getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount <= 40)
                                   || getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
                                         == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount))
                           ||
                           // c) owner approves a requester (member doc for someone else, who has a pending request)
                           (request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid
                              && memberUid != request.auth.uid
                              && request.resource.data.role == 'member'
                              && exists(/databases/$(database)/documents/guilds/$(guildId)/joinRequests/$(memberUid))
                              // TODO-strict-rules-at-2.1: restore strict +1 —
                              //   && getAfter(guild).data.memberCount == get(guild).data.memberCount + 1
                              // Transitional, absence-escape FIRST (existence-first idiom, arm-a template):
                              // a counterless guild would ERROR on getAfter/get memberCount, so
                              // !('memberCount' in get(guild)) short-circuits and admits the old-client-owner
                              // approval (no tick). Else owner-approve ticks the paired +1 (count-only update
                              // branch still caps <= 40), or an old owner client approves on a counted guild
                              // without ticking (getAfter == get). A NEW owner client on a counterless guild
                              // stays denied by the count-only update branch until a backfill re-run.
                              && (!('memberCount' in get(/databases/$(database)/documents/guilds/$(guildId)).data)
                                   || (getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
                                         == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount + 1
                                       && getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount <= 40)
                                   || getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
                                         == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount))
                         );

        allow update: if false;  // no role changes in G1

        // Delete: a member leaves (but the owner cannot leave), or the owner kicks / disbands.
        //
        // GUILD-CAP-1 carve-out — the paired -1 is REQUIRED only on the self-leave
        // arm. That is the anti-inflation control: without it a member could
        // leave-WITHOUT-decrement, then rejoin (+1), ratcheting the count up to the
        // cap to lock others out. The OWNER arm is deliberately NOT gated on the -1:
        // kickMember DOES send it, but disbandGuild deletes every member doc through a
        // SEPARATE, multi-batch teardown (deleteInBatches) that writes no count and
        // drops the guild doc only afterward — those deletes carry no -1, and the
        // guild doc still EXISTS during them, so neither an existsAfter guard nor a
        // -1 requirement can distinguish disband from kick here. Requiring the -1
        // would therefore break disband. An owner mis-stepping their own count is the
        // already-accepted owner-tamper limitation (see canDecrementMemberCount),
        // bounded to their guild and healed by re-running the backfill.
        allow delete: if request.auth != null
                      && (
                           (request.auth.uid == memberUid
                              && memberUid != get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid
                              // TODO-strict-rules-at-2.1: restore strict paired -1 —
                              //   && getAfter(guild).data.memberCount == get(guild).data.memberCount - 1
                              // Transitional, absence-escape FIRST (existence-first idiom, arm-a template):
                              // a counterless guild would ERROR on getAfter/get memberCount, so
                              // !('memberCount' in get(guild)) short-circuits and admits the old-client leave
                              // (no tick). Else a new client sends the paired -1, or an old client leaves a
                              // counted guild without ticking (getAfter == get). A NEW-client account inside a
                              // counterless guild cannot leave until a backfill re-run (the count-only update
                              // branch denies the -1 on an absent counter). Dev-only, accepted.
                              && (!('memberCount' in get(/databases/$(database)/documents/guilds/$(guildId)).data)
                                   || getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
                                        == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount - 1
                                   || getAfter(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount
                                        == get(/databases/$(database)/documents/guilds/$(guildId)).data.memberCount))
                           || request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid
                         );
      }

      match /joinRequests/{requesterUid} {
        // Read: the requester (own) or the owner (to review).
        allow read: if request.auth != null
                    && (request.auth.uid == requesterUid
                        || request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid);

        // Create: a non-member requests to join a REQUEST-policy guild, as themselves.
        allow create: if request.auth != null
                      && request.resource.data.uid == requesterUid
                      && request.auth.uid == requesterUid
                      && request.resource.data.keys().hasOnly(['uid','username','displayName','createdAt',
                           'avatarIcon','avatarColor'])
                      && request.resource.data.username is string && request.resource.data.username.size() < 300
                      && request.resource.data.displayName is string && request.resource.data.displayName.size() < 300
                      // D3b avatar fields (requester snapshot; copied into the member doc on approval).
                      && (!('avatarIcon' in request.resource.data)
                          || (request.resource.data.avatarIcon is string && request.resource.data.avatarIcon.size() < 40))
                      && (!('avatarColor' in request.resource.data)
                          || (request.resource.data.avatarColor is string && request.resource.data.avatarColor.size() < 40))
                      && get(/databases/$(database)/documents/guilds/$(guildId)).data.joinPolicy == 'request'
                      && !exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(requesterUid))
                      && !exists(/databases/$(database)/documents/guildMemberships/$(requesterUid));

        allow update: if false;

        // Delete: requester cancels, or owner approves/denies.
        allow delete: if request.auth != null
                      && (request.auth.uid == requesterUid
                          || request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid);
      }

      // Guild chat (G3) — messages readable/sendable by members; deletable by
      // the sender (own) or the owner (moderation). Leaving/being kicked/disband
      // makes the members/{me} exists() false, so the listener's read drops to a
      // terminal permission error — which the client converts to ejection.
      match /messages/{msgId} {
        // Read: members of this guild only.
        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid));

        // Create: a member sends as themselves, exact shape, bounded non-empty text.
        allow create: if request.auth != null
                      && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid))
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['senderUid','senderUsername','senderDisplayName','text','createdAt',
                           'senderAvatarIcon','senderAvatarColor'])
                      && request.resource.data.senderUsername is string && request.resource.data.senderUsername.size() < 300
                      && request.resource.data.senderDisplayName is string && request.resource.data.senderDisplayName.size() < 300
                      // D3b avatar fields (per-message sender snapshot).
                      && (!('senderAvatarIcon' in request.resource.data)
                          || (request.resource.data.senderAvatarIcon is string && request.resource.data.senderAvatarIcon.size() < 40))
                      && (!('senderAvatarColor' in request.resource.data)
                          || (request.resource.data.senderAvatarColor is string && request.resource.data.senderAvatarColor.size() < 40))
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 500;

        allow update: if false;  // messages immutable (no edit in v1)

        // Delete: the sender (own) or the guild owner (moderation).
        allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.senderUid
                          || request.auth.uid == get(/databases/$(database)/documents/guilds/$(guildId)).data.ownerUid);
      }
    }

    // Top-level one-guild lock
    match /guildMemberships/{uid} {
      // Read your own lock (this is the "find my guild" read).
      allow read: if request.auth != null && request.auth.uid == uid;

      // Create: doc id == uid, exact shape, and either you create your OWN lock
      // (founder/open-join) or the owner of the referenced guild creates a
      // requester's lock on approval (pending request must exist). The
      // doc-id-as-lock makes a second concurrent membership impossible.
      allow create: if request.auth != null
                    && request.resource.data.uid == uid
                    && request.resource.data.keys().hasOnly(['uid','guildCode','role','joinedAt'])
                    && request.resource.data.guildCode is string
                    && (
                         // M4: a SELF-written lock is valid ONLY alongside a real member
                         // doc written in the SAME atomic write (WriteBatch or transaction —
                         // Firestore treats both atomically and getAfter sees both). This
                         // defeats a forged lock with an arbitrary guildCode, which would
                         // otherwise falsely assert membership in a guild never joined. The client's
                         // founder-create and open-join flows already batch member-doc + lock.
                         (request.auth.uid == uid
                            && getAfter(/databases/$(database)/documents/guilds/$(request.resource.data.guildCode)/members/$(uid)).data.uid == uid)
                         ||
                         (request.auth.uid == get(/databases/$(database)/documents/guilds/$(request.resource.data.guildCode)).data.ownerUid
                            && uid != request.auth.uid
                            && exists(/databases/$(database)/documents/guilds/$(request.resource.data.guildCode)/joinRequests/$(uid)))
                       );

      allow update: if false;

      // Delete: a member releases their own lock (but not the owner — owner must
      // disband), or the owner of the referenced guild removes it (kick / disband).
      allow delete: if request.auth != null
                    && (
                         (request.auth.uid == uid
                            && get(/databases/$(database)/documents/guilds/$(resource.data.guildCode)).data.ownerUid != uid)
                         || request.auth.uid == get(/databases/$(database)/documents/guilds/$(resource.data.guildCode)).data.ownerUid
                       );
    }

    // Duel matchmaking queue (D2) — doc-id-as-lock (one ticket per user; precedent:
    // guildMemberships). Tickets are readable by any authenticated user (open
    // matchmaking; ephemeral snapshot — see design brief D7). The claim is the ONLY
    // cross-user write: claimedBy "" → claimer uid, atomically alongside the duel
    // create (verified there via getAfter).
    match /duelQueue/{uid} {
      allow read: if request.auth != null;

      // Owner CREATES their own unclaimed ticket, exact shape. There is deliberately no
      // overwrite path: enqueue is delete-then-create (setData over an existing doc
      // evaluates as an update, which this rule set intentionally does not permit beyond
      // the keep-alive and the claim). rr bounded sanely;
      // league mirrors DuelConstants.leagues; claimedBy must start as "".
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid','username','displayName','rr','league','createdAt','expiresAt','claimedBy'])
        && request.resource.data.username is string && request.resource.data.username.size() < 300
        && request.resource.data.displayName is string && request.resource.data.displayName.size() < 300
        && request.resource.data.rr is int
        && request.resource.data.rr >= 0 && request.resource.data.rr <= 100000
        && request.resource.data.league in [1, 3, 5]
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.claimedBy == '';

      // Two legal updates:
      //  a) owner re-stamps expiresAt on their own UNCLAIMED ticket (poll keep-alive)
      //  b) the CLAIM: another user sets claimedBy ""→their uid + claimedAt +
      //     matchedDuelId on a live, unclaimed ticket
      allow update: if request.auth != null
        && (
             (request.auth.uid == uid
                && resource.data.claimedBy == ''
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
                && request.resource.data.expiresAt is timestamp)
             ||
             (request.auth.uid != uid
                && resource.data.claimedBy == ''
                && request.time < resource.data.expiresAt
                && request.resource.data.claimedBy == request.auth.uid
                && request.resource.data.matchedDuelId is string
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['claimedBy','claimedAt','matchedDuelId']))
           );

      // Owner deletes anytime (cancel/cleanup); anyone deletes an EXPIRED ticket (lazy sweep).
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.time > resource.data.expiresAt);
    }

    // Global leaderboard (D3) — owner-published, WORLD-readable projection (any
    // authenticated user; deliberate — this is the global ladder). Doc id == owner uid.
    // Contains ONLY ladder fields + identity snapshots; private data never lands here.
    match /leaderboard/{uid} {
      allow get, list: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['username','displayName','rr','wins1','wins3','wins5',
              'streak1','streak3','streak5','updatedAt',
              'avatarIcon','avatarColor'])
        && request.resource.data.username is string && request.resource.data.username.size() < 300
        && request.resource.data.displayName is string && request.resource.data.displayName.size() < 300
        && request.resource.data.rr is int && request.resource.data.rr >= 0 && request.resource.data.rr <= 100000
        && request.resource.data.wins1 is int && request.resource.data.wins1 >= 0
        && request.resource.data.wins3 is int && request.resource.data.wins3 >= 0
        && request.resource.data.wins5 is int && request.resource.data.wins5 >= 0
        && request.resource.data.streak1 is int && request.resource.data.streak1 >= 0
        && request.resource.data.streak3 is int && request.resource.data.streak3 >= 0
        && request.resource.data.streak5 is int && request.resource.data.streak5 >= 0
        && (!('avatarIcon' in request.resource.data)
            || (request.resource.data.avatarIcon is string && request.resource.data.avatarIcon.size() < 40))
        && (!('avatarColor' in request.resource.data)
            || (request.resource.data.avatarColor is string && request.resource.data.avatarColor.size() < 40));
      // updatedAt intentionally not type-checked (serverTimestamp sentinel precedent).

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Duels (D1a) — top-level, owned by neither participant (precedent: guilds).
    // A duel is queried by membership (participantUids arrayContains). D1a covers
    // the challenge lifecycle only; scoring/resolution transitions arrive in D1b.
    match /duels/{duelId} {
      // Participants only.
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantUids;

      // Create is factored into named helpers (D2) so the challenge path and the matchmade
      // path coexist. isChallengeCreate() is the D1a body verbatim (zero behavioral change:
      // participantUids MUST equal [challengerUid, opponentUid] exactly — index 0 = challenger
      // invariant). isMatchmadeCreate() is the born-active ranked-queue path.
      function isChallengeCreate() {
        return request.resource.data.challengerUid == request.auth.uid
          && request.resource.data.opponentUid is string
          && request.resource.data.opponentUid != request.auth.uid
          && request.resource.data.participantUids ==
               [request.resource.data.challengerUid, request.resource.data.opponentUid]
          && request.resource.data.status == 'pending'
          && request.resource.data.league in [1, 3, 5]
          && request.resource.data.challengerScore == 0
          && request.resource.data.opponentScore == 0
          && request.resource.data.respondBy is timestamp
          && request.resource.data.challengerUsername is string && request.resource.data.challengerUsername.size() < 300
          && request.resource.data.challengerDisplayName is string && request.resource.data.challengerDisplayName.size() < 300
          && request.resource.data.opponentUsername is string && request.resource.data.opponentUsername.size() < 300
          && request.resource.data.opponentDisplayName is string && request.resource.data.opponentDisplayName.size() < 300
          && (!('rematchOfDuelId' in request.resource.data)
                || request.resource.data.rematchOfDuelId is string)
          && request.resource.data.keys().hasOnly(['participantUids','challengerUid','opponentUid',
               'challengerUsername','challengerDisplayName','opponentUsername','opponentDisplayName',
               'league','status','createdAt','respondBy','challengerScore','opponentScore',
               'rematchOfDuelId',
               'challengerAvatarIcon','challengerAvatarColor','opponentAvatarIcon','opponentAvatarColor'])
          // D3b avatar fields (both sides' snapshot, stamped at challenge create only).
          && (!('challengerAvatarIcon' in request.resource.data)
                || (request.resource.data.challengerAvatarIcon is string && request.resource.data.challengerAvatarIcon.size() < 40))
          && (!('challengerAvatarColor' in request.resource.data)
                || (request.resource.data.challengerAvatarColor is string && request.resource.data.challengerAvatarColor.size() < 40))
          && (!('opponentAvatarIcon' in request.resource.data)
                || (request.resource.data.opponentAvatarIcon is string && request.resource.data.opponentAvatarIcon.size() < 40))
          && (!('opponentAvatarColor' in request.resource.data)
                || (request.resource.data.opponentAvatarColor is string && request.resource.data.opponentAvatarColor.size() < 40))
          // UGC-1a: neither party may block the other.
          && !blockedEither(request.auth.uid, request.resource.data.opponentUid);
      }

      // D2: matchmade create — born active, authored by the claimer, provable via the
      // claim written in the SAME transaction (getAfter sees post-transaction state).
      function isMatchmadeCreate() {
        return request.resource.data.challengerUid == request.auth.uid
          && request.resource.data.opponentUid is string
          && request.resource.data.opponentUid != request.auth.uid
          && request.resource.data.participantUids ==
               [request.resource.data.challengerUid, request.resource.data.opponentUid]
          && request.resource.data.status == 'active'
          && request.resource.data.matchmade == true
          && request.resource.data.league in [1, 3, 5]
          && request.resource.data.challengerScore == 0
          && request.resource.data.opponentScore == 0
          // acceptedAt/createdAt are intentionally NOT type-checked: they are written as
          // serverTimestamp sentinels (same precedent as usernames.claimedAt,
          // public/stats.updatedAt, feedEvents.createdAt). endAt/respondBy are
          // client-computed Dates and ARE checked.
          && request.resource.data.endAt is timestamp
          // C2: same league-window bound as the accept path (isPendingTransition),
          // closing the matchmade born-ended 0-0 draw-farm vector. league is pinned
          // in [1,3,5] above, so duration.value gets no rogue magnitude.
          && request.resource.data.endAt > request.time
          && request.resource.data.endAt <= request.time
               + duration.value(request.resource.data.league, 'd') + duration.value(1, 'h')
          && request.resource.data.respondBy is timestamp
          && request.resource.data.challengerUsername is string && request.resource.data.challengerUsername.size() < 300
          && request.resource.data.challengerDisplayName is string && request.resource.data.challengerDisplayName.size() < 300
          && request.resource.data.opponentUsername is string && request.resource.data.opponentUsername.size() < 300
          && request.resource.data.opponentDisplayName is string && request.resource.data.opponentDisplayName.size() < 300
          && request.resource.data.keys().hasOnly(['participantUids','challengerUid','opponentUid',
               'challengerUsername','challengerDisplayName','opponentUsername','opponentDisplayName',
               'league','status','createdAt','respondBy','acceptedAt','endAt',
               'challengerScore','opponentScore','challengerDayScores','opponentDayScores','matchmade'])
          // The proof: this very transaction claims the opponent's ticket for me and
          // points it at THIS duel document.
          && getAfter(/databases/$(database)/documents/duelQueue/$(request.resource.data.opponentUid)).data.claimedBy
               == request.auth.uid
          && getAfter(/databases/$(database)/documents/duelQueue/$(request.resource.data.opponentUid)).data.matchedDuelId
               == duelId
          // M2: the created duel's league MUST equal the CLAIMED ticket's league, so a
          // claimer cannot match a victim into a higher league (longer window / bigger
          // RR swings) they never opted into.
          && request.resource.data.league
               == getAfter(/databases/$(database)/documents/duelQueue/$(request.resource.data.opponentUid)).data.league
          // UGC-1a: neither party may block the other (symmetric — same as challenge).
          && !blockedEither(request.auth.uid, request.resource.data.opponentUid);
      }

      allow create: if request.auth != null
                    && (isChallengeCreate() || isMatchmadeCreate());

      // The update rule is factored into named helpers (D1b). RR-delta bounds are
      // league-scaled (D2.5) — see the winDeltaOk/lossDeltaOk/drawDeltaOk/
      // forfeitLossDeltaOk/forfeitWinnerDeltaOk helpers below, which mirror the
      // DuelConstants D2.5 table EXACTLY (edit both places in the same change). The score
      // ceiling 110 mirrors DuelConstants.maxDayScore — keep both in sync with the client.

      // D1a: pending → active/declined/expired (only status/acceptedAt/endAt change).
      function isPendingTransition() {
        return resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt','endAt'])
          && (
               (request.auth.uid == resource.data.opponentUid
                  && request.resource.data.status == 'active'
                  && request.time < resource.data.respondBy
                  // C2: bound endAt to the league window (+1h clock skew) so an accept
                  // cannot mint a born-ended 0-0 duel that farms the positive draw delta.
                  // league is read off the pre-accept doc, which passed isChallengeCreate
                  // (league in [1,3,5]) — so duration.value gets no rogue magnitude.
                  && request.resource.data.endAt is timestamp
                  && request.resource.data.endAt > request.time
                  && request.resource.data.endAt <= request.time
                       + duration.value(resource.data.league, 'd') + duration.value(1, 'h'))
               || (request.auth.uid == resource.data.opponentUid
                  && request.resource.data.status == 'declined')
               || (request.auth.uid in resource.data.participantUids
                  && request.resource.data.status == 'expired'
                  && request.time > resource.data.respondBy)
             );
      }

      // D1b: own-side score write on an active duel, before endAt. Only my three score fields.
      function isOwnScoreWrite() {
        return resource.data.status == 'active'
          && request.time < resource.data.endAt
          && (
               (request.auth.uid == resource.data.challengerUid
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['challengerScore','challengerDayScores','challengerScoreUpdatedAt'])
                  && request.resource.data.challengerScore is number
                  && request.resource.data.challengerScore >= 0
                  && request.resource.data.challengerScore <= resource.data.league * 110
                  && request.resource.data.challengerDayScores is list
                  && request.resource.data.challengerDayScores.size() <= resource.data.league)
               ||
               (request.auth.uid == resource.data.opponentUid
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['opponentScore','opponentDayScores','opponentScoreUpdatedAt'])
                  && request.resource.data.opponentScore is number
                  && request.resource.data.opponentScore >= 0
                  && request.resource.data.opponentScore <= resource.data.league * 110
                  && request.resource.data.opponentDayScores is list
                  && request.resource.data.opponentDayScores.size() <= resource.data.league)
             );
      }

      // D2.5: league-scaled RR delta bounds — mirrors DuelConstants exactly.
      function winDeltaOk(d, lg) {
        return (lg == 1 && d >= 25 && d <= 30)
            || (lg == 3 && d >= 38 && d <= 45)
            || (lg == 5 && d >= 50 && d <= 60);
      }
      function lossDeltaOk(d, lg) {
        return (lg == 1 && d >= -25 && d <= -20)
            || (lg == 3 && d >= -30 && d <= -25)
            || (lg == 5 && d >= -40 && d <= -30);
      }
      function forfeitLossDeltaOk(d, lg) {
        // FIXED forfeiter penalty == the league's harshest earned loss.
        return (lg == 1 && d == -25) || (lg == 3 && d == -30) || (lg == 5 && d == -40);
      }
      function drawDeltaOk(d, lg) {
        return (lg == 1 && d == 10) || (lg == 3 && d == 15) || (lg == 5 && d == 20);
      }
      function forfeitWinnerDeltaOk(d, lg) {
        return (lg == 1 && d >= 5 && d <= 10)
            || (lg == 3 && d >= 8 && d <= 15)
            || (lg == 5 && d >= 10 && d <= 20);
      }

      // D1b: resolve an ended duel; winner MUST match the frozen scores; deltas rule-bounded.
      function isResolve() {
        return request.auth.uid in resource.data.participantUids
          && resource.data.status == 'active'
          && request.resource.data.status == 'resolved'
          && request.time > resource.data.endAt
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','winnerUid','resolvedAt','challengerRRDelta','opponentRRDelta'])
          && (
               (resource.data.challengerScore > resource.data.opponentScore
                  && request.resource.data.winnerUid == resource.data.challengerUid
                  && winDeltaOk(request.resource.data.challengerRRDelta, resource.data.league)
                  && lossDeltaOk(request.resource.data.opponentRRDelta, resource.data.league))
               ||
               (resource.data.opponentScore > resource.data.challengerScore
                  && request.resource.data.winnerUid == resource.data.opponentUid
                  && winDeltaOk(request.resource.data.opponentRRDelta, resource.data.league)
                  && lossDeltaOk(request.resource.data.challengerRRDelta, resource.data.league))
               ||
               (resource.data.challengerScore == resource.data.opponentScore
                  && !('winnerUid' in request.resource.data)
                  && drawDeltaOk(request.resource.data.challengerRRDelta, resource.data.league)
                  && drawDeltaOk(request.resource.data.opponentRRDelta, resource.data.league))
             );
      }

      // D1b: forfeit an active duel; forfeiter loses, the other side takes an unearned win.
      function isForfeit() {
        return request.auth.uid in resource.data.participantUids
          && resource.data.status == 'active'
          && request.resource.data.status == 'forfeited'
          && request.resource.data.forfeitedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','forfeitedBy','resolvedAt','challengerRRDelta','opponentRRDelta'])
          && (
               (request.auth.uid == resource.data.challengerUid
                  && forfeitLossDeltaOk(request.resource.data.challengerRRDelta, resource.data.league)
                  && forfeitWinnerDeltaOk(request.resource.data.opponentRRDelta, resource.data.league))
               ||
               (request.auth.uid == resource.data.opponentUid
                  && forfeitLossDeltaOk(request.resource.data.opponentRRDelta, resource.data.league)
                  && forfeitWinnerDeltaOk(request.resource.data.challengerRRDelta, resource.data.league))
             );
      }

      // D1b: own-side "RR applied once" flag, false/absent → true. Nothing else changes.
      function isRRApplyFlag() {
        return request.auth.uid in resource.data.participantUids
          && resource.data.status in ['resolved','forfeited']
          && (
               (request.auth.uid == resource.data.challengerUid
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengerRRApplied'])
                  && request.resource.data.challengerRRApplied == true
                  && resource.data.get('challengerRRApplied', false) == false)
               ||
               (request.auth.uid == resource.data.opponentUid
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponentRRApplied'])
                  && request.resource.data.opponentRRApplied == true
                  && resource.data.get('opponentRRApplied', false) == false)
             );
      }

      allow update: if request.auth != null
                    && (isPendingTransition() || isOwnScoreWrite() || isResolve() || isForfeit() || isRRApplyFlag());

      // Cancel: challenger deletes own pending challenge.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.challengerUid
                    && resource.data.status == 'pending';
    }

    // UGC-1a: write-only moderation mailbox. Owned by neither party (precedent:
    // duels); clients may only create; the operator reads via the console.
    // contentSnapshot cap 1000 mirrors UGCConstants.maxReportSnapshotLength.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['reporterUid','reportedUid','contextType','contentSnapshot',
              'guildCode','messageId','createdAt'])
        && request.resource.data.contextType in ['chat_message','user_profile','guild']
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid.size() >= 1
        && request.resource.data.reportedUid.size() < 128
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.contentSnapshot is string
        && request.resource.data.contentSnapshot.size() <= 1000
        && (!('guildCode' in request.resource.data)
              || (request.resource.data.guildCode is string
                  && request.resource.data.guildCode.size() < 64))
        && (!('messageId' in request.resource.data)
              || (request.resource.data.messageId is string
                  && request.resource.data.messageId.size() < 128));
      // createdAt intentionally not type-checked (serverTimestamp sentinel precedent)
    }
  }
}
